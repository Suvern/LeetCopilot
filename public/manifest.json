{
  "manifest_version": 3,
  "name": "LeetLens - AI LeetCode Assistant",
  "version": "0.1.0",
  "description": "在 leetcode.cn 题目页面提供中文 AI 编程助手。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://leetcode.cn/*", "https://api.deepseek.com/*"],
  "action": { "default_title": "打开 LeetLens 设置", "default_popup": "src/popup/index.html" },
  "background": { "service_worker": "assets/background.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://leetcode.cn/problems/*"], "js": ["assets/content.js"], "css": ["assets/content.css"], "run_at": "document_idle" }],
  "icons": {}
}
