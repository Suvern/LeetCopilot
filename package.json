{
  "name": "leetcopilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suvern/LeetCopilot.git"
  },
  "homepage": "https://github.com/Suvern/LeetCopilot#readme",
  "bugs": {
    "url": "https://github.com/Suvern/LeetCopilot/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.config.ts && vite build --config vite.content.config.ts",
    "package": "pnpm run build && node scripts/pack-extension.mjs",
    "check:version": "node scripts/check-version.mjs",
    "prebuild": "pnpm run check:version",
    "release": "node scripts/prepare-release.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/browser-smoke.mjs && node tests/stream-smoke.mjs",
    "test:smoke": "pnpm run test:e2e"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.39.1",
    "@solidjs/router": "^0.15.4",
    "dompurify": "^3.2.6",
    "lucide-solid": "^0.468.0",
    "marked": "^16.1.2",
    "solid-js": "^1.9.9"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "archiver": "^7.0.1",
    "eslint": "^9.34.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^3.2.4"
  }
}
